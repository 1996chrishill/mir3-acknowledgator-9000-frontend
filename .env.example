# Comments must be on their own lines: docker run --env-file keeps inline comments as part of the value.

# Backend API base URL as the browser reaches it. Backend CORS_ORIGINS must include this frontend's origin.
API_URL=https://mir3-ack-api.example.com

# Host port (compose only)
HOST_PORT=32263

# Pending list auto-refresh, seconds. 0 = off.
REFRESH_SECONDS=60

# Fetch timeout for /pending and ack calls, seconds (login + several acks can take a while)
REQUEST_TIMEOUT_S=180

# Max history entries shown
HISTORY_LIMIT=200
